<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ptmj.datum.mapper.PtmjNotificationMapper">
    
    <resultMap type="PtmjNotification" id="PtmjNotificationResult">
        <result property="notifyId"    column="notify_id"    />
        <result property="notifyType"    column="notify_type"    />
        <result property="title"    column="title"    />
        <result property="content"    column="content"    />
        <result property="status"    column="status"    />
        <result property="sort"    column="sort"    />
        <result property="displayMode"    column="display_mode"    />
        <result property="faultStartTime"    column="fault_start_time"    />
        <result property="faultEndTime"    column="fault_end_time"    />
        <result property="maintenanceStartTime"    column="maintenance_start_time"    />
        <result property="maintenanceEndTime"    column="maintenance_end_time"    />
        <result property="remindBeforeMinutes"    column="remind_before_minutes"    />
        <result property="uploadUserId"    column="upload_user_id"    />
        <result property="materialId"    column="material_id"    />
        <result property="materialTitleSnapshot"    column="material_title_snapshot"    />
        <result property="publishStart"    column="publish_start"    />
        <result property="publishEnd"    column="publish_end"    />
        <result property="scrollTimeInterval"    column="scroll_time_interval"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPtmjNotificationVo">
        select notify_id, notify_type, title, content, status, sort, display_mode, fault_start_time, fault_end_time, maintenance_start_time, maintenance_end_time, remind_before_minutes, upload_user_id, material_id, material_title_snapshot, publish_start, publish_end, scroll_time_interval, create_by, create_time, update_by, update_time, remark from ptmj_notification
    </sql>

    <select id="selectPtmjNotificationList" parameterType="PtmjNotification" resultMap="PtmjNotificationResult">
        <include refid="selectPtmjNotificationVo"/>
        <where>
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="displayMode != null and displayMode != ''"> and display_mode = #{displayMode}</if>
            <if test="materialId != null"> and material_id = #{materialId}</if>
            <!-- 管理端：按故障(类型2)或维护(类型3)时间段与所选区间有交集 -->
            <if test="params.faultMaintBegin != null and params.faultMaintBegin != '' and params.faultMaintEnd != null and params.faultMaintEnd != ''">
                and (
                    (notify_type = '2' and fault_start_time is not null
                        and fault_start_time &lt;= #{params.faultMaintEnd}
                        and (fault_end_time is null or fault_end_time &gt;= #{params.faultMaintBegin}))
                    or
                    (notify_type = '3' and maintenance_start_time is not null
                        and maintenance_start_time &lt;= #{params.faultMaintEnd}
                        and (maintenance_end_time is null or maintenance_end_time &gt;= #{params.faultMaintBegin}))
                )
            </if>
        </where>
    </select>
    
    <select id="selectPtmjNotificationByNotifyId" parameterType="Long" resultMap="PtmjNotificationResult">
        <include refid="selectPtmjNotificationVo"/>
        where notify_id = #{notifyId}
    </select>

    <insert id="insertPtmjNotification" parameterType="PtmjNotification" useGeneratedKeys="true" keyProperty="notifyId">
        insert into ptmj_notification
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="notifyType != null and notifyType != ''">notify_type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null">content,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sort != null">sort,</if>
            <if test="displayMode != null and displayMode != ''">display_mode,</if>
            <if test="faultStartTime != null">fault_start_time,</if>
            <if test="faultEndTime != null">fault_end_time,</if>
            <if test="maintenanceStartTime != null">maintenance_start_time,</if>
            <if test="maintenanceEndTime != null">maintenance_end_time,</if>
            <if test="remindBeforeMinutes != null">remind_before_minutes,</if>
            <if test="uploadUserId != null">upload_user_id,</if>
            <if test="materialId != null">material_id,</if>
            <if test="materialTitleSnapshot != null">material_title_snapshot,</if>
            <if test="publishStart != null">publish_start,</if>
            <if test="publishEnd != null">publish_end,</if>
            <if test="scrollTimeInterval != null">scroll_time_interval,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="notifyType != null and notifyType != ''">#{notifyType},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="displayMode != null and displayMode != ''">#{displayMode},</if>
            <if test="faultStartTime != null">#{faultStartTime},</if>
            <if test="faultEndTime != null">#{faultEndTime},</if>
            <if test="maintenanceStartTime != null">#{maintenanceStartTime},</if>
            <if test="maintenanceEndTime != null">#{maintenanceEndTime},</if>
            <if test="remindBeforeMinutes != null">#{remindBeforeMinutes},</if>
            <if test="uploadUserId != null">#{uploadUserId},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="materialTitleSnapshot != null">#{materialTitleSnapshot},</if>
            <if test="publishStart != null">#{publishStart},</if>
            <if test="publishEnd != null">#{publishEnd},</if>
            <if test="scrollTimeInterval != null">#{scrollTimeInterval},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePtmjNotification" parameterType="PtmjNotification">
        update ptmj_notification
        <trim prefix="SET" suffixOverrides=",">
            <if test="notifyType != null and notifyType != ''">notify_type = #{notifyType},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="displayMode != null and displayMode != ''">display_mode = #{displayMode},</if>
            <if test="faultStartTime != null">fault_start_time = #{faultStartTime},</if>
            <if test="faultEndTime != null">fault_end_time = #{faultEndTime},</if>
            <if test="maintenanceStartTime != null">maintenance_start_time = #{maintenanceStartTime},</if>
            <if test="maintenanceEndTime != null">maintenance_end_time = #{maintenanceEndTime},</if>
            <if test="remindBeforeMinutes != null">remind_before_minutes = #{remindBeforeMinutes},</if>
            <if test="uploadUserId != null">upload_user_id = #{uploadUserId},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="materialTitleSnapshot != null">material_title_snapshot = #{materialTitleSnapshot},</if>
            <if test="publishStart != null">publish_start = #{publishStart},</if>
            <if test="publishEnd != null">publish_end = #{publishEnd},</if>
            <if test="scrollTimeInterval != null">scroll_time_interval = #{scrollTimeInterval},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where notify_id = #{notifyId}
    </update>

    <delete id="deletePtmjNotificationByNotifyId" parameterType="Long">
        delete from ptmj_notification where notify_id = #{notifyId}
    </delete>

    <delete id="deletePtmjNotificationByNotifyIds" parameterType="String">
        delete from ptmj_notification where notify_id in 
        <foreach item="notifyId" collection="array" open="(" separator="," close=")">
            #{notifyId}
        </foreach>
    </delete>
</mapper>