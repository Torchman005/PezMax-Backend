<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ptmj.datum.mapper.DesktopAuthMapper">

    <!-- 撰写人：LYX 桌面端认证专用用户映射 -->
    <resultMap id="DesktopUserResult" type="com.ptmj.datum.domain.PtmjUser">
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="password" column="password"/>
        <result property="avatar" column="avatar"/>
        <result property="count" column="count"/>
        <result property="status" column="status"/>
        <result property="creatBy" column="creat_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <!-- 撰写人：LYX 桌面端认证专用密保映射 -->
    <resultMap id="DesktopSecurityResult" type="com.ptmj.datum.domain.PtmjSecurity">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="question" column="question"/>
        <result property="answer" column="answer"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="desktopUserColumns">
        select user_id, user_name, password, avatar, count, status, creat_by, create_time, update_by, update_time, remark
        from ptmj_user
    </sql>

    <sql id="desktopSecurityColumns">
        select id, user_id, question, answer, create_by, create_time, update_by, update_time, remark
        from ptmj_security
    </sql>

    <select id="selectUserByUserName" resultMap="DesktopUserResult">
        <include refid="desktopUserColumns"/>
        where user_name = #{userName}
        limit 1
    </select>

    <select id="selectUserByUserId" resultMap="DesktopUserResult">
        <include refid="desktopUserColumns"/>
        where user_id = #{userId}
        limit 1
    </select>

    <select id="countUserByUserName" resultType="int">
        select count(1)
        from ptmj_user
        where user_name = #{userName}
    </select>

    <insert id="insertDesktopUser" parameterType="com.ptmj.datum.domain.PtmjUser" useGeneratedKeys="true" keyProperty="userId">
        insert into ptmj_user
        (
            user_name,
            password,
            avatar,
            count,
            status,
            creat_by,
            create_time,
            remark
        )
        values
        (
            #{userName},
            #{password},
            #{avatar},
            #{count},
            #{status},
            #{creatBy},
            #{createTime},
            #{remark}
        )
    </insert>

    <insert id="insertDesktopSecurity" parameterType="com.ptmj.datum.domain.PtmjSecurity" useGeneratedKeys="true" keyProperty="id">
        insert into ptmj_security
        (
            user_id,
            question,
            answer,
            create_by,
            create_time,
            remark
        )
        values
        (
            #{userId},
            #{question},
            #{answer},
            #{createBy},
            #{createTime},
            #{remark}
        )
    </insert>

    <select id="selectSecurityByUserId" resultMap="DesktopSecurityResult">
        <include refid="desktopSecurityColumns"/>
        where user_id = #{userId}
        limit 1
    </select>

    <update id="updateDesktopUserPassword" parameterType="com.ptmj.datum.domain.PtmjUser">
        update ptmj_user
        set password = #{password},
            update_by = #{updateBy},
            update_time = #{updateTime}
        where user_id = #{userId}
    </update>

    <update id="updateDesktopUserProfile" parameterType="com.ptmj.datum.domain.PtmjUser">
        update ptmj_user
        <set>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where user_id = #{userId}
    </update>

    <update id="updateDesktopUserAvatar" parameterType="com.ptmj.datum.domain.PtmjUser">
        update ptmj_user
        set avatar = #{avatar},
            update_by = #{updateBy},
            update_time = sysdate()
        where user_id = #{userId}
    </update>

    <update id="updateDesktopSecurity" parameterType="com.ptmj.datum.domain.PtmjSecurity">
        update ptmj_security
        <set>
            <if test="question != null and question != ''">question = #{question},</if>
            <if test="answer != null and answer != ''">answer = #{answer},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where user_id = #{userId}
    </update>
</mapper>
