<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ptmj.datum.mapper.PtmjAuthMapper">

    <!-- 撰写人：LYX Ptmj 登录认证专用用户映射 -->
    <resultMap id="PtmjUserResult" type="com.ptmj.datum.domain.PtmjUser">
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="password" column="password"/>
        <result property="avatar" column="avatar"/>
        <result property="count" column="count"/>
        <result property="status" column="status"/>
        <result property="creatBy" column="creat_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="ptmjUserColumns">
        select user_id, user_name, password, avatar, count, status, creat_by, create_time, update_by, update_time, remark
        from ptmj_user
    </sql>

    <select id="selectUserByUserName" resultMap="PtmjUserResult">
        <include refid="ptmjUserColumns"/>
        where user_name = #{userName}
        limit 1
    </select>
</mapper>
